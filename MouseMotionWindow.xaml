<Window x:Class="MidiKey.MouseMotionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GamusicStudio · 鼠标横移" Width="495" SizeToContent="Height"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
 Style="{StaticResource {x:Type Window}}">
 <StackPanel Margin="22,18,22,20">
  <TextBlock Text="鼠标横移" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
  <TextBlock Text="左转向左移，右转向右移。" Style="{StaticResource MutedText}" Margin="0,5,0,14"/>
  <Border Style="{StaticResource PanelBox}" Padding="12">
   <DockPanel>
    <Button x:Name="LearnButton" DockPanel.Dock="Right" Content="学习旋钮" Click="ToggleLearning"
     Margin="10,0,0,0" VerticalAlignment="Center"/>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="已绑定的旋钮" Style="{StaticResource MutedText}" Margin="0,0,0,3"/>
     <TextBlock x:Name="BindingLabel" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Accent}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Margin="0,15,0,0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="2*"/>
    <ColumnDefinition Width="14"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="旋钮信号" Margin="0,0,0,5"/>
    <ComboBox x:Name="ModePicker" AutomationProperties.Name="旋钮信号">
     <ComboBoxItem Content="自动识别"/>
     <ComboBoxItem Content="绝对位置（0–127）"/>
     <ComboBoxItem Content="Mackie 相对步进（1 / 65）"/>
    </ComboBox>
   </StackPanel>
   <StackPanel Grid.Column="2">
    <TextBlock Text="移动速度" Margin="0,0,0,5"/>
    <ComboBox x:Name="SpeedPicker" AutomationProperties.Name="鼠标横移速度"
     ToolTip="数值越大，旋钮每转一步移动越远。"/>
   </StackPanel>
  </Grid>
  <TextBlock x:Name="BindingStatus" Style="{StaticResource MutedText}" TextWrapping="Wrap" MinHeight="25" Margin="0,10,0,4"/>
  <DockPanel>
   <Button x:Name="RemoveButton" Content="清除绑定" DockPanel.Dock="Left" Click="RemoveBinding"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="取消" IsCancel="True" MinWidth="70" Margin="0,0,9,0"/>
    <Button x:Name="SaveButton" Content="保存" IsDefault="True" Click="SaveBinding" Style="{StaticResource PrimaryButton}" MinWidth="88"/>
   </StackPanel>
  </DockPanel>
 </StackPanel>
</Window>
