<Window x:Class="MidiKey.MappingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="编辑 MIDI 换键" Width="1080" Height="610" MinWidth="870" MinHeight="580"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
 <Grid Margin="20,14,20,14">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="1,0,0,12">
   <Button x:Name="RemoveMapping" DockPanel.Dock="Right" Content="删除换键" Padding="13,5"
    HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Error}" Click="Delete"/>
   <StackPanel>
    <TextBlock Text="编辑换键" Foreground="{StaticResource Accent}" FontSize="23" FontWeight="Bold"/>
    <TextBlock x:Name="SignalDetails" Style="{StaticResource MutedText}" Margin="0,3,8,0"/>
   </StackPanel>
  </DockPanel>
  <Border x:Name="VelocityPanel" Grid.Row="1" Style="{StaticResource PanelBox}" Padding="12,9" Margin="0,0,0,10" Visibility="Collapsed">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,6">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="最近力度" Style="{StaticResource MutedText}"/>
      <TextBlock Text="{Binding DisplayLastVelocity}" Foreground="{StaticResource Accent}" MinWidth="29"
       TextAlignment="Right" FontFamily="Consolas" FontSize="14" Margin="6,0,0,0"/>
     </StackPanel>
     <TextBlock Text="力度分档" FontSize="16" FontWeight="SemiBold"/>
    </DockPanel>
    <DockPanel Grid.Row="1">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
      <TextBlock Text="最低" VerticalAlignment="Center" Margin="0,0,5,0"/>
      <TextBox x:Name="VelocityMin" Width="46" TextAlignment="Center" MaxLength="3" TextChanged="PreviewRange" AutomationProperties.Name="最低触发力度"/>
      <TextBlock Text="最高" VerticalAlignment="Center" Margin="12,0,5,0"/>
      <TextBox x:Name="VelocityMax" Width="46" TextAlignment="Center" MaxLength="3" TextChanged="PreviewRange" AutomationProperties.Name="最高触发力度"/>
      <Button x:Name="RemoveLayerButton" Content="移除此档" Padding="9,4" Margin="12,0,0,0" Click="RemoveLayer"/>
      <Button Content="＋ 添加力度档" Padding="9,4" Margin="6,0,0,0" Click="AddLayer"/>
     </StackPanel>
     <ComboBox x:Name="LayerPicker" SelectionChanged="SelectLayer" AutomationProperties.Name="力度档"
      ToolTip="每档含最低和最高力度，超出所有档位的力度不会触发。"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsTextSearchEnabled="False"/>
    </DockPanel>
   </Grid>
  </Border>
  <Border Grid.Row="2" Style="{StaticResource PanelBox}" Padding="12,9" Margin="0,0,0,10">
   <StackPanel>
    <DockPanel Margin="0,0,0,6">
     <Button x:Name="KeyboardToggle" DockPanel.Dock="Right" Content="扩展按键" Click="ToggleKeyboard" Padding="10,4"/>
     <TextBlock Text="虚拟键盘" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>
    <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Center">
     <Grid x:Name="KeyboardSurface" Width="978" Height="218">
      <Grid x:Name="FullKeyboard">
       <Grid.ColumnDefinitions><ColumnDefinition Width="660"/><ColumnDefinition Width="134"/><ColumnDefinition Width="184"/></Grid.ColumnDefinitions>
       <StackPanel x:Name="MainKeys"/>
       <StackPanel x:Name="NavKeys" Grid.Column="1"/>
       <StackPanel x:Name="NumKeys" Grid.Column="2"/>
      </Grid>
      <WrapPanel x:Name="ExtraKeys" Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0"/>
     </Grid>
    </Viewbox>
   </StackPanel>
  </Border>
  <Border Grid.Row="3" Style="{StaticResource PanelBox}" Padding="12,10">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,7">
      <StackPanel x:Name="StepActions" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
       <Button Content="↑" Click="MoveUp" ToolTip="前移步骤" AutomationProperties.Name="前移步骤" Padding="7,3"/>
       <Button Content="↓" Click="MoveDown" ToolTip="后移步骤" AutomationProperties.Name="后移步骤" Padding="7,3" Margin="4,0,0,0"/>
       <Button Content="移除" Click="RemoveStep" Padding="7,3" Margin="4,0,0,0"/>
       <Button Content="＋ 添加步骤" Click="AddStep" Padding="8,3" Margin="4,0,0,0"/>
      </StackPanel>
      <TextBlock Text="执行顺序" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </DockPanel>
     <ListBox x:Name="Steps" Grid.Row="1" SelectionChanged="SelectStep" Background="{StaticResource Background}"
      BorderBrush="{StaticResource Line}" Foreground="{StaticResource White}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      AutomationProperties.Name="执行步骤">
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource White}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
         <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
           <Border x:Name="Frame" Background="Transparent" Padding="9,5">
            <ContentPresenter/>
           </Border>
           <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource ControlFill}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource SignalFill}"/></Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate>
         </Setter.Value>
        </Setter>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </Grid>
    <Grid Grid.Column="2">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,5">
      <StackPanel x:Name="KeyModeControls" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
       <TextBlock Text="方式" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,7,0"/>
       <ComboBox x:Name="KeyMode" Width="91" MinHeight="27" SelectionChanged="ChangeKeyMode" AutomationProperties.Name="按键方式">
        <ComboBoxItem Content="触发"/>
        <ComboBoxItem Content="长按"/>
       </ComboBox>
      </StackPanel>
      <TextBlock x:Name="StepTitle" Text="步骤 1" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock x:Name="StepHelp" Grid.Row="1" Text="同一步选择多个键可组成组合键。" Style="{StaticResource MutedText}" Margin="0,0,0,7"/>
     <Grid x:Name="TimingControls" Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,7,0"><TextBlock Text="连按次数" Margin="0,0,0,3"/><TextBox x:Name="RepeatBox" AutomationProperties.Name="连按次数" MaxLength="3"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,7,0"><TextBlock Text="连按间隔 (ms)" Margin="0,0,0,3"/><TextBox x:Name="RepeatGapBox" AutomationProperties.Name="连按间隔" MaxLength="5"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="到下一步 (ms)" Margin="0,0,0,3"/><TextBox x:Name="NextGapBox" AutomationProperties.Name="到下一步的间隔" MaxLength="5"/></StackPanel>
     </Grid>
     <StackPanel x:Name="ThresholdControls" Grid.Row="3" Orientation="Horizontal" Margin="0,7,0,0" Visibility="Collapsed">
      <TextBlock Text="触发条件" VerticalAlignment="Center" Margin="0,0,7,0"/>
      <ComboBox x:Name="Direction" Width="105" MinHeight="27" SelectedIndex="0" SelectionChanged="ChangeDirection" AutomationProperties.Name="阈值方向">
       <ComboBoxItem Content="上升至"/>
       <ComboBoxItem Content="下降至"/>
      </ComboBox>
      <TextBox x:Name="ThresholdBox" Width="62" Margin="5,0,0,0" MaxLength="5" AutomationProperties.Name="触发阈值"/>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>
  <DockPanel Grid.Row="4" Margin="0,11,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="取消" IsCancel="True" MinWidth="70" Margin="0,0,8,0"/>
    <Button Content="保存换键" Click="Save" Style="{StaticResource PrimaryButton}" MinWidth="102"/>
   </StackPanel>
   <TextBlock x:Name="ErrorText" Foreground="{StaticResource Error}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
  </DockPanel>
 </Grid>
</Window>
