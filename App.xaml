<Application x:Class="MidiKey.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Startup="OnStartup">
 <Application.Resources>
  <SolidColorBrush x:Key="Background" Color="#080711"/>
  <SolidColorBrush x:Key="Panel" Color="#100D1C"/>
  <SolidColorBrush x:Key="ControlFill" Color="#1E142B"/>
  <SolidColorBrush x:Key="Line" Color="#39284C"/>
  <SolidColorBrush x:Key="ControlEdge" Color="#894389"/>
  <SolidColorBrush x:Key="White" Color="#F6EFFF"/>
  <SolidColorBrush x:Key="Muted" Color="#BCADCE"/>
  <SolidColorBrush x:Key="Accent" Color="#00FFFF"/>
  <SolidColorBrush x:Key="Magenta" Color="#FF00FF"/>
  <SolidColorBrush x:Key="AccentInk" Color="#071015"/>
  <SolidColorBrush x:Key="SelectionFill" Color="#2B1740"/>
  <SolidColorBrush x:Key="SignalFill" Color="#0A3039"/>
  <SolidColorBrush x:Key="PianoEnabled" Color="#184553"/>
  <SolidColorBrush x:Key="PianoAreaEdge" Color="#AB58C1"/>
  <SolidColorBrush x:Key="Error" Color="#FF9CC0"/>
  <LinearGradientBrush x:Key="Workspace" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#171025" Offset="0"/>
   <GradientStop Color="#0B0816" Offset="0.47"/>
   <GradientStop Color="#060B15" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PanelSurface" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#191125" Offset="0"/>
   <GradientStop Color="#100D1C" Offset="0.54"/>
   <GradientStop Color="#100D1C" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PanelEdge" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#8B3B94" Offset="0"/>
   <GradientStop Color="#513168" Offset="0.37"/>
   <GradientStop Color="#283A59" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PrimaryFill" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#231035" Offset="0"/>
   <GradientStop Color="#110D21" Offset="0.47"/>
   <GradientStop Color="#09232B" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="MeterFill" StartPoint="0,0.5" EndPoint="1,0.5">
   <GradientStop Color="#B835E3" Offset="0"/>
   <GradientStop Color="#00FFFF" Offset="1"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="ButtonInset" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.58" RadiusY="0.72">
   <GradientStop Color="#0000FFFF" Offset="0.3"/>
   <GradientStop Color="#0D00FFFF" Offset="0.78"/>
   <GradientStop Color="#2300FFFF" Offset="1"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="HoverInset" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.55" RadiusY="0.7">
   <GradientStop Color="#00FF00FF" Offset="0.26"/>
   <GradientStop Color="#22FF00FF" Offset="0.73"/>
   <GradientStop Color="#66FF00FF" Offset="1"/>
  </RadialGradientBrush>
  <DropShadowEffect x:Key="PinkGlow" Color="#FF00FF" BlurRadius="15" ShadowDepth="0" Opacity="0.42"/>
  <DropShadowEffect x:Key="CyanGlow" Color="#00FFFF" BlurRadius="26" ShadowDepth="0" Opacity="0.77"/>
  <DropShadowEffect x:Key="PressGlow" Color="White" BlurRadius="42" ShadowDepth="0" Opacity="0.84"/>
  <QuadraticEase x:Key="EaseOut" EasingMode="EaseOut"/>
  <Style TargetType="Window">
   <Setter Property="Icon" Value="pack://application:,,,/Assets/KeyPitch.ico"/>
   <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{StaticResource White}"/>
   <Setter Property="Background" Value="{StaticResource Workspace}"/>
   <Setter Property="UseLayoutRounding" Value="True"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="Background" Value="{StaticResource ControlFill}"/>
   <Setter Property="BorderBrush" Value="{StaticResource ControlEdge}"/>
   <Setter Property="Foreground" Value="{StaticResource White}"/>
   <Setter Property="Padding" Value="7,4"/>
  </Style>
  <Style x:Key="ScrollPage" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Background" Value="{StaticResource Panel}"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ScrollBar">
     <Grid Background="{TemplateBinding Background}">
      <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
       <Track.DecreaseRepeatButton><RepeatButton x:Name="Previous" Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
       <Track.IncreaseRepeatButton><RepeatButton x:Name="Next" Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
       <Track.Thumb><Thumb>
        <Thumb.Template><ControlTemplate TargetType="Thumb">
         <Border x:Name="Fill" Margin="2" Background="{StaticResource ControlEdge}" CornerRadius="3"/>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Background" Value="{StaticResource Accent}"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Thumb.Template>
       </Thumb></Track.Thumb>
      </Track>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
       <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
       <Setter TargetName="Previous" Property="Command" Value="ScrollBar.PageLeftCommand"/>
       <Setter TargetName="Next" Property="Command" Value="ScrollBar.PageRightCommand"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="Orientation" Value="Vertical"><Setter Property="Width" Value="11"/></Trigger>
    <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="11"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="MutedText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
  </Style>
  <Style x:Key="PanelBox" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource PanelSurface}"/>
   <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Accent}"/>
   <Setter Property="Background" Value="{StaticResource ButtonInset}"/>
   <Setter Property="BorderBrush" Value="{StaticResource ControlEdge}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="13,6"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid Background="Transparent">
      <Grid x:Name="Surface" RenderTransformOrigin="0.5,0.5">
       <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
       <Border x:Name="HoverGlow" CornerRadius="4" BorderBrush="{StaticResource Accent}" BorderThickness="2"
        Effect="{StaticResource CyanGlow}" Opacity="0" IsHitTestVisible="False"/>
       <Border x:Name="WhiteFlash" CornerRadius="4" Background="White" Effect="{StaticResource PressGlow}"
        Opacity="0" IsHitTestVisible="False"/>
       <Border x:Name="Frame" CornerRadius="4" Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
       <Border x:Name="Inset" Margin="{TemplateBinding BorderThickness}" CornerRadius="3"
        Background="{StaticResource HoverInset}" Opacity="0" IsHitTestVisible="False"/>
       <Border x:Name="Highlight" Margin="2" CornerRadius="3" VerticalAlignment="Top" Height="1"
        Opacity="0" IsHitTestVisible="False">
        <Border.Background>
         <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#0000FFFF" Offset="0"/>
          <GradientStop Color="#DDFFFFFF" Offset=".5"/>
          <GradientStop Color="#0000FFFF" Offset="1"/>
         </LinearGradientBrush>
        </Border.Background>
       </Border>
       <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"
        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
      </Grid>
      </Grid>
      <ControlTemplate.Triggers>
       <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/>
        <MultiTrigger.EnterActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20" EasingFunction="{StaticResource EaseOut}"/>
         <DoubleAnimation Storyboard.TargetName="Inset" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20" EasingFunction="{StaticResource EaseOut}"/>
         <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.25"/>
        </Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
        <MultiTrigger.ExitActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20" EasingFunction="{StaticResource EaseOut}"/>
         <DoubleAnimation Storyboard.TargetName="Inset" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20" EasingFunction="{StaticResource EaseOut}"/>
         <DoubleAnimation Storyboard.TargetName="Highlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.30"/>
        </Storyboard></BeginStoryboard></MultiTrigger.ExitActions>
       </MultiTrigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Frame" Property="Background" Value="White"/>
        <Setter TargetName="Frame" Property="BorderBrush" Value="White"/>
        <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource AccentInk}"/>
        <Setter TargetName="Inset" Property="Visibility" Value="Collapsed"/>
        <Trigger.EnterActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.90" Duration="0:0:0.20" EasingFunction="{StaticResource EaseOut}"/>
         <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.90" Duration="0:0:0.20" EasingFunction="{StaticResource EaseOut}"/>
         <DoubleAnimation Storyboard.TargetName="WhiteFlash" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
         <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.20" EasingFunction="{StaticResource EaseOut}"/>
         <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.20" EasingFunction="{StaticResource EaseOut}"/>
         <DoubleAnimation Storyboard.TargetName="WhiteFlash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20" EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard></BeginStoryboard></Trigger.ExitActions>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.40"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="{StaticResource Accent}"/>
   <Setter Property="Background" Value="{StaticResource PrimaryFill}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Magenta}"/>
   <Setter Property="BorderThickness" Value="2"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Effect" Value="{StaticResource PinkGlow}"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Effect" Value="{x:Null}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Padding" Value="9,4"/>
   <Setter Property="Foreground" Value="{StaticResource Accent}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Face" CornerRadius="4" Background="{StaticResource ButtonInset}" BorderBrush="{StaticResource ControlEdge}" BorderThickness="1">
           <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource Accent}" StrokeThickness="1.5"
            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
           <Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <ContentPresenter Margin="10,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False" TextElement.Foreground="{TemplateBinding Foreground}"
        Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
       <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" Focusable="False" AllowsTransparency="True">
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource ControlEdge}" BorderThickness="1"
         CornerRadius="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="3">
         <ScrollViewer MaxHeight="290"><ItemsPresenter/></ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Toggle" Property="Effect" Value="{StaticResource PinkGlow}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{StaticResource White}"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Frame" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent">
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource SelectionFill}"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource White}"/>
   <Setter Property="Background" Value="{StaticResource Background}"/>
   <Setter Property="BorderBrush" Value="{StaticResource ControlEdge}"/>
   <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
   <Setter Property="SelectionBrush" Value="{StaticResource Magenta}"/>
   <Setter Property="Padding" Value="7,4"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Style.Triggers>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource White}"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <StackPanel Orientation="Horizontal" Background="Transparent">
       <Grid Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center">
        <Border x:Name="Box" CornerRadius="3" BorderBrush="{StaticResource ControlEdge}" BorderThickness="1"
         Background="{StaticResource ButtonInset}"/>
        <Path x:Name="Check" Visibility="Collapsed" Data="M3,7 L6,10 L12,4" Stroke="{StaticResource Accent}"
         StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
       </Grid>
       <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
      </StackPanel>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource White}"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Application.Resources>
</Application>
