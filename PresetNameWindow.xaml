<Window x:Class="MidiKey.PresetNameWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="450" SizeToContent="Height"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
 Style="{StaticResource {x:Type Window}}">
 <Grid Margin="22,17,22,18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock x:Name="Heading" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,14"/>
  <StackPanel Grid.Row="1">
   <Label Content="夺舍程序名称" Target="{Binding ElementName=NameBox}" Foreground="{StaticResource White}" Padding="0,0,0,4"/>
   <TextBox x:Name="NameBox" MinHeight="34" AutomationProperties.Name="夺舍程序名称"/>
  </StackPanel>
  <TextBlock x:Name="NameError" Grid.Row="2" Foreground="{StaticResource Error}" MinHeight="25" Margin="0,5,0,0" TextWrapping="Wrap"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="取消" IsCancel="True" MinWidth="70" Margin="0,0,9,0"/>
   <Button Content="保存" IsDefault="True" Click="SaveName" Style="{StaticResource PrimaryButton}" MinWidth="88"/>
  </StackPanel>
 </Grid>
</Window>
