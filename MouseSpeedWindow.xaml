<Window x:Class="MidiKey.MouseSpeedWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GamusicStudio · 鼠标灵敏度" Width="576" SizeToContent="Height"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
 Style="{StaticResource {x:Type Window}}">
 <Window.Resources>
  <Style x:Key="PointerSpeedSliderStyle" TargetType="Slider">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Slider">
      <Grid Background="Transparent">
       <Track x:Name="PART_Track">
        <Track.Resources>
         <Style TargetType="RepeatButton">
          <Setter Property="Focusable" Value="False"/>
          <Setter Property="Template">
           <Setter.Value>
            <ControlTemplate TargetType="RepeatButton">
             <Grid Background="Transparent">
              <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}"/>
             </Grid>
            </ControlTemplate>
           </Setter.Value>
          </Setter>
         </Style>
        </Track.Resources>
        <Track.DecreaseRepeatButton>
         <RepeatButton Background="{StaticResource MeterFill}" Command="Slider.DecreaseLarge"/>
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
         <RepeatButton Background="{StaticResource Line}" Command="Slider.IncreaseLarge"/>
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
         <Thumb Width="20" Height="28" Cursor="SizeWE">
          <Thumb.Template>
           <ControlTemplate TargetType="Thumb">
            <Border x:Name="Handle" CornerRadius="5" Background="{StaticResource Accent}">
             <Rectangle Width="2" Height="12" RadiusX="1" RadiusY="1" Fill="{StaticResource AccentInk}"/>
            </Border>
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Handle" Property="Background" Value="{StaticResource White}"/>
             </Trigger>
             <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Handle" Property="Effect" Value="{StaticResource CyanGlow}"/>
             </Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Thumb.Template>
         </Thumb>
        </Track.Thumb>
       </Track>
       <Border x:Name="FocusFrame" CornerRadius="6" Margin="-5,-1" BorderBrush="{StaticResource Accent}"
        BorderThickness="1" Visibility="Hidden" IsHitTestVisible="False"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="FocusFrame" Property="Visibility" Value="Visible"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="PART_Track" Property="Opacity" Value=".45"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <StackPanel Margin="24,19,24,22">
  <TextBlock Text="Gamusic Studio" Foreground="{StaticResource Magenta}" FontFamily="Arial"
   FontStyle="Italic" FontWeight="Bold" FontSize="17" Margin="1,0,0,9"/>
  <Border Style="{StaticResource PanelBox}" Background="{StaticResource PrimaryFill}" Padding="18,14" Margin="0,0,0,15">
   <StackPanel>
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock x:Name="CurrentSpeed" FontSize="40" FontWeight="Bold" FontFamily="Segoe UI"
       Foreground="{StaticResource Accent}" AutomationProperties.Name="当前档位"/>
      <TextBlock Text="/ 20" Style="{StaticResource MutedText}" FontSize="16" VerticalAlignment="Bottom" Margin="7,0,0,7"/>
     </StackPanel>
     <TextBlock Text="鼠标灵敏度" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
    </DockPanel>
    <Slider x:Name="SpeedSlider" Height="32" Margin="1,10,1,2" Minimum="1" Maximum="20"
     TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="1"
     Style="{StaticResource PointerSpeedSliderStyle}" AutomationProperties.Name="Windows 鼠标灵敏度" ValueChanged="ChangeSpeed"/>
    <DockPanel Margin="2,1,2,8" LastChildFill="False">
     <TextBlock Text="1  慢" Style="{StaticResource MutedText}" DockPanel.Dock="Left"/>
     <TextBlock Text="快  20" Style="{StaticResource MutedText}" DockPanel.Dock="Right"/>
    </DockPanel>
    <TextBlock x:Name="SpeedStatus" Style="{StaticResource MutedText}"/>
   </StackPanel>
  </Border>
  <Border Style="{StaticResource PanelBox}" Padding="12">
   <DockPanel>
    <Button x:Name="LearnButton" DockPanel.Dock="Right" Content="学习 MIDI 控件" Click="ToggleLearning"
     Margin="12,0,0,0" VerticalAlignment="Center"/>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="已绑定的控件" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
     <TextBlock x:Name="BindingLabel" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Accent}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <TextBlock Text="MIDI 灵敏度范围" Margin="0,15,0,5"/>
  <StackPanel Orientation="Horizontal">
   <ComboBox x:Name="MinimumSpeed" Width="90" AutomationProperties.Name="最低鼠标灵敏度"/>
   <TextBlock Text="至" VerticalAlignment="Center" Margin="10,0"/>
   <ComboBox x:Name="MaximumSpeed" Width="90" AutomationProperties.Name="最高鼠标灵敏度"/>
  </StackPanel>
  <TextBlock x:Name="BindingStatus" Style="{StaticResource MutedText}" TextWrapping="Wrap" MinHeight="27" Margin="0,9,0,4"/>
  <DockPanel>
   <Button x:Name="RemoveButton" Content="清除绑定" DockPanel.Dock="Left" Click="RemoveBinding"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="取消" IsCancel="True" MinWidth="70" Margin="0,0,9,0"/>
    <Button x:Name="SaveButton" Content="保存" IsDefault="True" Click="SaveBinding" Style="{StaticResource PrimaryButton}" MinWidth="88"/>
   </StackPanel>
  </DockPanel>
 </StackPanel>
</Window>
