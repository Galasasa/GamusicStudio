<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GamusicStudio</AssemblyName>
    <AssemblyTitle>GamusicStudio 键知弹</AssemblyTitle>
    <Product>GamusicStudio</Product>
    <ApplicationIcon>Assets\KeyPitch.ico</ApplicationIcon>
    <RollForward>Major</RollForward>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\KeyPitch.ico"/>
    <EmbeddedResource Include="Assets\GamusicStudiio.png" LogicalName="StartupImage.png"/>
    <Resource Include="Assets\Presets\*.png"/>
  </ItemGroup>
</Project>
